---
import { getCollection } from 'astro:content';
import { site } from '../config';
import { contentDate, isPublic, selectFeatured } from '../lib/content';

// Research nav: homepage anchor when the feature renders, archive when public
// research exists without a homepage feature, omitted otherwise.
const research = await getCollection('research');
const hasResearchFeature = selectFeatured(research, contentDate.research, 1).length > 0;
const researchHref = hasResearchFeature ? '/#research' : research.some(isPublic) ? '/research' : null;
---

<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="site-name">{site.name}</a>
    <nav class="nav-links" aria-label="Main navigation">
      <details class="nav-disclosure">
        <summary>Menu</summary>
        <div class="nav-panel">
          <a href="/#experience">Experience</a>
          {researchHref && <a href={researchHref}>Research</a>}
          <a href="/projects">Lab</a>
          <a href="/blog">Writing</a>
          <a href="/resume.pdf" class="btn btn-sm" download>Resume</a>
        </div>
      </details>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Disclosure enhancement: Escape closes and returns focus; link click closes.
  // Without JS the native <details> toggle still exposes every link.
  const disclosure = document.querySelector<HTMLDetailsElement>('.nav-disclosure');
  const summary = disclosure?.querySelector<HTMLElement>('summary');
  const syncExpanded = () => {
    summary?.setAttribute('aria-expanded', String(disclosure?.open ?? false));
  };
  syncExpanded();
  disclosure?.addEventListener('toggle', syncExpanded);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && disclosure?.open) {
      disclosure.open = false;
      syncExpanded();
      summary?.focus();
    }
  });
  disclosure?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (disclosure.open) {
        disclosure.open = false;
        syncExpanded();
      }
    });
  });

  const btn = document.getElementById('theme-toggle');
  const syncTheme = () => {
    const isDark = document.documentElement.classList.contains('dark');
    btn?.setAttribute('aria-pressed', String(isDark));
    // Keep browser chrome (address bar) in sync with the manual toggle,
    // not just prefers-color-scheme. Selected by data-theme (stable across
    // toggles) rather than media (reassigned below on every sync).
    const meta = document.querySelector<HTMLMetaElement>(
      `meta[name="theme-color"][data-theme="${isDark ? 'dark' : 'light'}"]`
    );
    if (meta) {
      meta.media = 'all';
      document
        .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
        .forEach((m) => { if (m !== meta) m.media = 'not all'; });
    }
  };
  syncTheme();
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
    syncTheme();
  });
</script>
