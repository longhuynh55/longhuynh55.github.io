---
// Copy control — one button plus its own polite live region. Renders the
// markup and wires every instance on the page through a single inline script
// (no shared chunk, no duplicated clipboard code between pages). The copied
// text is passed in, so the visible source (the email link, the citation
// paragraph) stays the only rendering of it.

interface Props {
  /** Text placed on the clipboard. */
  value: string;
  /** Visible button label; restored after a successful copy. */
  label: string;
  /** Live-region message after a successful copy. */
  done?: string;
  /** Live-region message when the copy fails. */
  failed?: string;
}

const { value, label, done = 'Copied', failed = 'Copy failed' } = Astro.props;
// Deterministic id — labels are unique per page, so this needs no randomness.
const statusId = `copy-status-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<button
  type="button"
  class="copy-control"
  data-copy-value={value}
  data-copy-status={statusId}
  data-copy-label={label}
  data-copy-done={done}
  data-copy-failed={failed}>{label}</button>
<span id={statusId} class="visually-hidden" aria-live="polite"></span>

<script>
  // Clipboard with a legacy fallback (no Clipboard API / non-secure context).
  // Each button swaps its label for 2s and reports through its own live region.
  const writeClipboard = async (text: string): Promise<boolean> => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.top = '-1000px';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    textarea.remove();
    return ok;
  };

  document.querySelectorAll<HTMLButtonElement>('button[data-copy-value]').forEach((button) => {
    const status = document.getElementById(button.dataset.copyStatus ?? '');
    let resetTimer = 0;
    button.addEventListener('click', async () => {
      const ok = await writeClipboard(button.dataset.copyValue ?? '');
      if (status) {
        status.textContent = ok ? (button.dataset.copyDone ?? 'Copied') : (button.dataset.copyFailed ?? 'Copy failed');
      }
      if (!ok) return;
      button.textContent = 'Copied';
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.textContent = button.dataset.copyLabel ?? 'Copy';
        // Announce only the change: the region ends consistent with the label.
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
