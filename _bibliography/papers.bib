  title       = {Financial-Condition-Guided Retrieval for Adaptive Bayesian Decision Forecasting Under Structural Breaks},
  author      = {Liêu, Hoài Phúc and Tran, Binh Nguyen Y. and Nguyen, Ngoc Thi Anh and Pham, Kim Le Bao and Phan, Tin Nguyen Tri and Nguyen, Son Phuc},
  booktitle   = {Trends and Applications in Knowledge Discovery and Data Mining (PAKDD 2026 Workshops, DMO Fintech)},
  series      = {Lecture Notes in Artificial Intelligence},
  volume      = {16603},
  pages       = {337--348},
  year        = {2026},
